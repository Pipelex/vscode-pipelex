exports[`corpus snapshots (committed expected outputs) > format pipe-definitions.mthds 1`] = `
{
  "changed": true,
  "diagnostics": [],
  "formatted": "# Test: Pipe table headers, type entries, model entries, inputs/output
# Covers: [pipe], [pipe.name], type, output, model, inputs (single-line)

domain      = "test_pipe-definitions"
description = "Test fixture for pipe definitions"

[pipe]

[pipe.analyze_features]
type        = "PipeLLM"
description = "Analyze features"
inputs      = { photo = "native.Image" }
output      = "FeatureAnalysis"
model       = "$gpt-4o"

[pipe.create_prompt]
type        = "PipeLLM"
description = "Create a prompt for image generation"
inputs      = { opposite_concept = "OppositeConcept" }
output      = "ImagePrompt"
model       = "@my-alias"

[pipe.generate_image]
type        = "PipeImgGen"
description = "Generate the image"
inputs      = { image_prompt = "ImagePrompt" }
output      = "images.Photo"
model       = "~waterfall"

[pipe.simple_gen]
type        = "PipeLLM"
description = "Simple generation"
output      = "Text"
model       = "claude-3-opus"

# Multi-input pipe
[pipe.combine_data]
type        = "PipeLLM"
description = "Combine multiple data sources"
inputs      = { a = "TypeA", b = "TypeB", c = "native.TypeC" }
output      = "CombinedResult"
",
}
`;

exports[`corpus snapshots (committed expected outputs) > format prompt-templates.mthds 1`] = `
{
  "changed": false,
  "diagnostics": [],
  "formatted": "# Test: Prompt templates with data injection and template variables
# Covers: prompt_template block strings, @injection, $template_variable

domain      = "test_prompt-templates"
description = "Test fixture for prompt templates"

[pipe.ask]
type = "PipeLLM"
description = "Analyze input data using a template"
inputs = { input_data = "RawData" }
output = "Analysis"
prompt_template = """
Analyze this:
@input_data

Using template: $template_name

Be concise.
"""

# Prompt with multiple injections
[pipe.compare]
type = "PipeLLM"
description = "Compare two items"
inputs = { item_a = "ItemA", item_b = "ItemB" }
output = "Comparison"
prompt_template = """
Compare these two items:

First item:
@item_a

Second item:
@item_b

$comparison_format
"""

# Single-line prompt_template
[pipe.simple_ask]
type            = "PipeLLM"
prompt_template = "Summarize: @document"

# Prompt with dotted variable names
[pipe.nested_ref]
type = "PipeLLM"
prompt_template = """
@context.details
$output.format
"""
",
}
`;

exports[`corpus snapshots (committed expected outputs) > format steps.mthds 1`] = `
{
  "changed": true,
  "diagnostics": [],
  "formatted": "# Test: Step objects with pipe references, result, batch_over, batch_as
# Covers: pipe = "name" in inline tables, result/batch_as/batch_over variables

domain      = "test_steps"
description = "Test fixture for steps"

[pipe.sequence]
type = "PipeSequence"
description = "A multi-step pipeline"
inputs = { data = "InputData" }
output = "FinalResult"
steps = [
  { pipe = "step_one", result = "first_result" },
  { pipe = "step_two", batch_over = "items", batch_as = "item", result = "second_result" },
  { pipe = "step_three", result = "final_output" },
]

# Condition pipe with pipe_map
[pipe.condition]
type              = "PipeCondition"
description       = "Route based on condition"
inputs            = { data = "InputData" }
output            = "OutputData"
expression        = "data.category"
pipe_map          = { "type_a" = "handle_type_a", "type_b" = "handle_type_b" }
default_pipe_code = "handle_default"
",
}
`;

