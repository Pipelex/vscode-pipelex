exports[`corpus snapshots (committed expected outputs) > format concept-tables.mthds 1`] = `
{
  "changed": true,
  "diagnostics": [],
  "formatted": "# Test: Concept table header variations
# Covers: [concept], [concept.Name], [concept.Name.structure], generic tables

domain      = "test_concept-tables"
description = "Test fixture for concept tables"

[concept]
Name = "Description"

[concept.FeatureAnalysis]
description = "Analysis of features"

[concept.FeatureAnalysis.structure]
field       = { type = "text", required = true }
description = "A plain text field"
nested_ref  = { type = "text", description = "Nested field definition" }

# Namespaced concept in refines
[concept.ImagePrompt]
description = "A prompt for image generation"
refines     = "images.ImgGenPrompt"
",
}
`;

exports[`corpus snapshots (committed expected outputs) > format false-positives.mthds 1`] = `
{
  "changed": true,
  "diagnostics": [],
  "formatted": "# Test: Ensure plain strings are NOT colored as Jinja/HTML/injections
# Covers: literal strings (no MTHDS patterns), plain definition values, structure fields

domain      = "test_false-positives"
description = "Test fixture for false positives"

[concept.PlainText]
description = "A simple text concept with words that could false-match"
remark      = "The variable foo should not be colored"

# Literal strings must NOT match @injection or $template or {{ jinja }}
note = 'Literal string: @not_injection $not_template {{ not_jinja }}'
multiline_literal = '''
@also_not_injection
$also_not_template
{% not_jinja %}
<not_html>
'''

# Structure fields with type = "text" should NOT get pipe-type coloring
[concept.PlainText.structure]
field_a = { type = "text", required = true }
field_b = { type = "text", description = "A plain text field" }

# Boolean and number values
enabled = true
count   = 42
ratio   = 3.14
hex_val = 0xFF
",
}
`;

