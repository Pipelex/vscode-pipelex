{
  "name": "@pipelex/tools-wasm",
  "version": "0.2.0",
  "description": "MTHDS lint & format compiled to WASM — fully offline (embedded schema), same engine and Diagnostic wire shape as pipelex-tools-py and the Pipelex API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn rollup --silent -c rollup.config.mjs",
