    "test:watch": "vitest",
    "prepublish": "RELEASE=true yarn build",
    "clean": "rm -rf dist"
  },
  "homepage": "https://github.com/Pipelex/vscode-pipelex",
  "repository": "https://github.com/Pipelex/vscode-pipelex",
  "author": {
    "name": "Pipelex",
